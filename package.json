{
  "author": "step-security",
  "bugs": {
    "url": "https://github.com/step-security/setup-groovy/issues"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/http-client": "4.0.1",
    "@actions/tool-cache": "4.0.0",
    "axios": "1.20.0",
    "fast-xml-parser": "5.11.1",
    "semver": "7.8.5"
  },
  "description": "Sets up Groovy for Github Actions",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.12.0",
    "@types/semver": "7.8.0",
    "@vercel/ncc": "0.45.0",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "homepage": "https://github.com/step-security/setup-groovy",
  "keywords": [
    "actions",
    "groovy",
    "setup",
    "apache"
  ],
  "license": "MIT",
  "main": "lib/src/main.js",
  "name": "@step-security/setup-groovy",
  "private": true,
  "publisher": "step-security",
  "repository": {
    "type": "git",
    "url": "https://github.com/step-security/setup-groovy.git"
  },
  "scripts": {
    "build": "tsc",
    "format": "npx biome format --write",
    "format-check": "npx biome format",
    "lint": "npx biome lint --write",
    "format+lint": "npx biome check --write",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "update-dist": "npm run build && npm run package",
    "all": "npm run build && npm run format+lint && npm run package && npm run coverage"
  },
  "type": "module",
  "version": "3.0.2"
}
